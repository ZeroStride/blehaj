[Unit]
Description=Unnamed Network Configuration Automation Project
After=multi-user.target network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/unnamed wlan0
Environment="RUST_LOG=warn,unnamed=debug"
Restart=on-failure

# Dynamic User causes an I/O error
# DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RemoveIPC=yes

Group=netdev
ConfigurationDirectory=unnamed
ConfigurationDirectoryMode=0555

RestrictRealtime=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
