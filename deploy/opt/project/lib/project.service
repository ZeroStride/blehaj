[Unit]
Description=Unnamed Network Configuration Automation Project
After=multi-user.target network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/unnamed --signing-key "${CREDENTIALS_DIRECTORY}/unnamed_ed25519" --qr-code-url-prefix "http://localhost:3000/?uuid=" wlan0
Environment="RUST_LOG=warn,unnamed=debug"
Restart=on-failure
# Dynamic User causes an I/O error
# DynamicUser=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RemoveIPC=yes
Group=netdev
LoadCredentialEncrypted=unnamed_ed25519
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
